{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "background",
  "description": "Hidden window: owns session, network, keychain, tray and notifications.",
  "windows": [
    "background"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:event:default",
    "core:tray:default",
    "core:menu:default",
    "core:app:allow-default-window-icon",
    "core:window:allow-get-all-windows",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "notification:default",
    "allow-vault-read",
    "allow-vault-write",
    "allow-vault-delete",
    "allow-heartwood-start",
    "allow-heartwood-stop",
    "allow-heartwood-info",
    "allow-heartwood-call",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.execute-api.*.amazonaws.com/*"
        },
        {
          "url": "https://cognito-idp.*.amazonaws.com/"
        }
      ]
    },
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "claude://*"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    "deep-link:default"
  ]
}
